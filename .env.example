# ============================================================================
#  Till - private keys. NEVER commit this file. NEVER paste it into a chat.
#  .gitignore already excludes it. Burner wallets only.
# ============================================================================

# ----------------------------------------------------------------------------
#  AGENT A  -  THE BUYER
#  This is the wallet you funded with  >>> USD1 <<<  (~2.50)
#  It signs payment authorizations off-chain. It never sends a transaction,
#  so it needs NO BNB.
#  >>> PUT THE PRIVATE KEY OF YOUR **USD1** WALLET HERE <<<
# ----------------------------------------------------------------------------
BUYER_PRIVATE_KEY=

# ----------------------------------------------------------------------------
#  AGENT B  -  THE SELLER
#  This is the wallet you funded with  >>> BNB <<<  (~0.50 worth)
#  It broadcasts receiveWithAuthorization and pays the gas.
#  It also RECEIVES the USD1 from Agent A.
#  >>> PUT THE PRIVATE KEY OF YOUR **BNB / GAS** WALLET HERE <<<
# ----------------------------------------------------------------------------
SELLER_PRIVATE_KEY=

# ============================================================================
#  Everything below is already correct. You do not need to change it.
# ============================================================================

# BNB Smart Chain
CHAIN_ID=56
RPC_URL=https://bsc-dataseed.binance.org

# USD1 (World Liberty Financial USD) - EIP-3009 verified on-chain
TOKEN_ADDRESS=0x8d0D000Ee44948FC98c9B98A4FA4921476f08B0d
TOKEN_DECIMALS=18
TOKEN_EIP712_NAME=World Liberty Financial USD
TOKEN_EIP712_VERSION=1

# Fallback asset if USD1 is hard to get (United Stables) - same EIP-3009 surface
# TOKEN_ADDRESS=0xcE24439F2D9C6a2289F741120FE202248B666666
# TOKEN_EIP712_NAME=United Stables

# Demo economics (USD1)
SKILL_PRICE=0.10
MANDATE_DAILY_CAP=1.00
DEEP_DIVE_PRICE=5.00

PORT=3000

# Agent A's decision-making. Without a key the buyer still decides, but by
# deterministic rules - and the tape says so rather than implying a model ran.
ANTHROPIC_API_KEY=
